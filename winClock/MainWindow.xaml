<Window x:Class="winClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:winClock"
        mc:Ignorable="d"
        Title="winClock" Margin="2" Height="327" Width="311" AllowsTransparency="True" 
        WindowStyle="None" Background="Transparent" WindowStartupLocation="CenterScreen" 
        Icon="images/clock.ico" 
        ResizeMode="CanResizeWithGrip" Topmost="False" Opacity="1">
    
    <Viewbox>
        <Grid Width="300" Height="300" MouseLeftButtonDown="Grid_MouseDown">
            <Image Source="images/backGround.png"></Image>

            <Label Name="labelInfo" Foreground="White" 
        Margin="0, 0, 0, 200" HorizontalAlignment="Center" 
        VerticalAlignment="Bottom" Height="Auto" 
        Width="Auto" FontFamily="Times New Roman" >winClock By Thomas
            </Label>

            <Label Name="labelDate" Foreground="White" 
        Margin="0, 0, 0, 75" HorizontalAlignment="Center" 
        VerticalAlignment="Bottom" Height="Auto" 
        Width="Auto" FontFamily="Times New Roman" >Date
            </Label>
            
            <Label Name="labelTime" Foreground="White" 
        Margin="0, 0, 0, 52" HorizontalAlignment="Center" 
        VerticalAlignment="Bottom" Height="Auto"
         Width="Auto">Time
            </Label>
            
            <!--SECOND-->
            <Rectangle Margin="150,0,149,150" Name="rectangleSecond" Stroke="White" Height="120" VerticalAlignment="Bottom">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="secondHand" CenterX="0" CenterY="120" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            
            <!--MINUTE-->
            <Rectangle Margin="150,49,149,150" Name="rectangleMinute" Stroke="Cyan">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="minuteHand" CenterX="0" CenterY="100" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <!--HOUR-->
            <Rectangle Margin="150,80,149,149" Name="rectangleHour" Stroke="Cyan">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="hourHand" CenterX="0" CenterY="70" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            
            <Ellipse Width="10" Height="10" Fill="White" Canvas.Left="150" Canvas.Top="150"/>
            <Ellipse Width="7" Height="7" Fill="Black" Canvas.Left="150" Canvas.Top="150"/>
            <Ellipse Width="264" Height="264" Stroke="Gold" Canvas.Left="150" Canvas.Top="150"/>
            <Ellipse Width="268" Height="268" Stroke="Gold" Canvas.Left="150" Canvas.Top="150"/>
            <Ellipse Width="270" Height="270" Stroke="Gold" Canvas.Left="150" Canvas.Top="150"/>
            <Ellipse Width="274" Height="274" Stroke="Gold" Canvas.Left="150" Canvas.Top="150"/>

        </Grid>
    </Viewbox>

</Window>
